# Copy to the recovery worktree's .env, then generate local secrets with
# ./scripts/bootstrap-backend-env.sh. Never copy the original checkout's .env.
COMPOSE_PROJECT_NAME=lazytt-resume-pgvector
POSTGRES_HOST_PORT=56432
MEM0_HOST_PORT=19888
MEM0_BASE_URL=http://127.0.0.1:19888
MEM0_COLLECTION_NAME=resume_qwen3_1024
LOCAL_RETRIEVAL_MODELS_PORT=19082
RETRIEVAL_MODELS_HOST=127.0.0.1
RETRIEVAL_MODELS_PORT=19082
MEMORY_BIND=127.0.0.1:19080
MEMORY_BASE_URL=http://127.0.0.1:19080
DEMO_WEB_API_BIND=127.0.0.1:19090
DEMO_WEB_API_URL=http://127.0.0.1:19090
NEXT_PUBLIC_DEMO_API_URL=http://127.0.0.1:19090
DEMO_WEB_PORT=13000
DEMO_WEB_ALLOWED_ORIGINS=http://127.0.0.1:13000,http://localhost:13000
MEMORY_AUTH_MODE=jwt_hs256
MEMORY_TENANT_IDS=resume-tenant
DEMO_TENANT_ID=resume-tenant
MEMORY_BOOTSTRAP_EMPTY_PROJECTION=true
MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:19082
MEMORY_DEDICATED_RERANK_BASE_URL=http://127.0.0.1:19082
MEMORY_EMBEDDING_API_KEY=local-model-no-secret
MEMORY_DEDICATED_RERANK_API_KEY=local-model-no-secret
# Disabled for offline preparation. Enabling kimi requires separate live acceptance.
MEMORY_EXTRACT_MODE=disabled
# Prevent implicit Hugging Face downloads, even when the model launcher is run later.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
WRANGLER_SEND_METRICS=false
DO_NOT_TRACK=1
# DATABASE_URL and DEMO_DATABASE_URL are derived after loading generated secrets;
# see docs/resume-recovery.md. Real cloud keys are intentionally absent.
