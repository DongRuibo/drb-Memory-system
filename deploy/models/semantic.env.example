# Model identities are part of the projection generation contract. Change them
# only together with a new generation and a controlled Mem0 rebuild.
MEMORY_EMBEDDING_PROVIDER=local-qwen
MEMORY_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
MEMORY_EMBEDDING_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
MEMORY_EMBEDDING_DIMENSIONS=1024
MEMORY_EMBEDDING_NORMALIZATION=l2
MEMORY_EMBEDDING_INSTRUCTION_VERSION=mem0-symmetric-document-v1
MEMORY_EMBEDDING_SEMANTIC=true
MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:18082

MEMORY_RERANK_MODE=dedicated
MEMORY_DEDICATED_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
MEMORY_DEDICATED_RERANK_REVISION=e61197e
MEMORY_DEDICATED_RERANK_BASE_URL=http://127.0.0.1:18082
MEMORY_DEDICATED_RERANK_MINIMUM_SCORE=0.10
MEMORY_DEDICATED_RERANK_TIMEOUT_SECONDS=10

MEMORY_EXTRACT_MODE=kimi
# KIMI_EXTRACT_API_KEY must come from the process environment or a local 0600
# .env file. Never put a real key in this example.
