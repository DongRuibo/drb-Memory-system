# Reference only. Administrator-owned ECS /etc/lazytt/memory.env must be root:root 0600.
# The migrate action requires only these three runtime DB settings, plus a separate owner file.
export MEM0_POSTGRES_HOST='<STORE_PRIVATE_ADDRESS>'
export MEM0_POSTGRES_PORT='5432'
export MEM0_POSTGRES_RUNTIME_PASSWORD='<REDACTED>'

# Complete these before configure/release. Reuse an authorized existing source when available.
export LAZYTT_MEMORY_ELASTICSEARCH_ENDPOINT='https://<STORE_ELASTICSEARCH_HOST>'
export ELASTICSEARCH_PORT='9200'
export ELASTICSEARCH_USERNAME='<MEMORY_INDEX_SCOPED_USER>'
export STORE_ELASTICSEARCH_PASSWORD='<REDACTED>'
export ELASTICSEARCH_INDEX_PREFIX='lazytt-memory-dev'
export MEMORY_EMBEDDING_BASE_URL='https://<EMBEDDING_PROVIDER>/v1'
export MEMORY_EMBEDDING_API_KEY='<REDACTED>'
export MEMORY_EMBEDDING_MODEL='<EMBEDDING_MODEL>'
export MEMORY_EMBEDDING_DIMENSIONS='<ACTUAL_DIMENSIONS>'
export MEMORY_EXTRACT_BASE_URL='https://<CHAT_PROVIDER>/v1'
export MEMORY_EXTRACT_API_KEY='<REDACTED>'
export MEMORY_EXTRACT_MODEL='<CHAT_MODEL>'

# Internal Mem0 key, at least 32 bytes; never give it to clients.
export MEM0_API_KEY='<REDACTED>'
# trusted_user_id: only a trusted backend may connect and supply identity headers.
# Dynamic tenant/user IDs need no registration or whitelist.
export LAZYTT_MEMORY_HOST_PORT='18081'

# Business binding; health is always published to host loopback only.
export LAZYTT_MEMORY_HOST_BIND='127.0.0.1'
export LAZYTT_MEMORY_HEALTH_PORT='18082'
