# Copy this file to .env, replace placeholders, then run:
#   ./scripts/bootstrap-backend-env.sh
# The bootstrap script generates the local database, Mem0 and JWT secrets.

# Required only when MEMORY_EXTRACT_MODE=kimi. Set the mode to disabled when
# the Agent supplies explicit memory events and no automatic Kimi extraction is needed.
KIMI_API_KEY=replace-with-your-kimi-api-key
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=k3

MEMORY_EXTRACT_MODE=kimi
MEMORY_JWT_ISSUER=lazytt-demo-web-api
MEMORY_JWT_AUDIENCE=lazytt-memory-service
MEMORY_TENANT_IDS=demo-tenant
DEMO_TENANT_ID=demo-tenant
DEMO_USER_ID=semantic-demo
DEMO_PROJECT_ID=lazytt-memory-system-demo

# Generated locally by scripts/bootstrap-backend-env.sh. Never commit real values.
MEMORY_POSTGRES_PASSWORD=
MEM0_POSTGRES_PASSWORD=
MEM0_API_KEY=
MEM0_JWT_SECRET=
MEMORY_JWT_HS256_SECRET=

# Optional cloud profile. The same SiliconFlow key may be used for both calls.
MEMORY_EMBEDDING_PROVIDER=siliconflow
MEMORY_EMBEDDING_BASE_URL=https://api.siliconflow.cn
MEMORY_EMBEDDING_API_KEY=replace-with-your-siliconflow-key
MEMORY_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
MEMORY_EMBEDDING_REVISION=siliconflow-cloud-2026-07-31
MEMORY_EMBEDDING_DIMENSIONS=1024
MEMORY_EMBEDDING_NORMALIZATION=l2
MEMORY_EMBEDDING_INSTRUCTION_VERSION=mem0-symmetric-document-v1
MEMORY_EMBEDDING_SEMANTIC=true
MEMORY_EMBEDDING_TIMEOUT_SECONDS=30

MEMORY_RERANK_MODE=dedicated
MEMORY_DEDICATED_RERANK_BASE_URL=https://api.siliconflow.cn
MEMORY_DEDICATED_RERANK_API_KEY=replace-with-your-siliconflow-key
MEMORY_DEDICATED_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
MEMORY_DEDICATED_RERANK_REVISION=siliconflow-cloud-2026-07-31
MEMORY_DEDICATED_RERANK_MINIMUM_SCORE=0.10
MEMORY_DEDICATED_RERANK_TIMEOUT_SECONDS=30

# Local model profile defaults. Change together with a new projection generation.
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
LOCAL_EMBEDDING_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
LOCAL_EMBEDDING_DIMENSIONS=1024
LOCAL_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
LOCAL_RERANK_REVISION=e61197e
MEM0_COLLECTION_NAME=memories_qwen3_1024

# Hugging Face download compatibility. Set HF_HUB_DISABLE_XET=0 when Xet works
# better on the current network; partial downloads resume from the model cache volume.
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=60
HF_HUB_ETAG_TIMEOUT=30
