# 复制为 .env 后填写占位值；真实密码、Key 和 Token 绝不能提交到 Git。
# 完整本地栈可运行下面的脚本生成本地数据库、Mem0 和 JWT 随机密钥：
#   ./scripts/bootstrap-backend-env.sh

# 百炼记忆提取：从 Agent 完成的一轮可见对话中提取长期记忆候选。
# 如果 Agent 只提交显式记忆事件、不需要自动提取，可将模式设为 disabled。
MEMORY_EXTRACT_MODE=openai_compatible
OPENAI_API_KEY=replace-with-your-bailian-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.7-flash

# 旧版 Kimi 兼容配置；只有 MEMORY_EXTRACT_MODE=kimi 时才使用。
KIMI_API_KEY=replace-with-your-kimi-api-key
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=k3
# 身份与租户：trusted_user_id 仅限受信任内网，由 Agent Runtime 写入
# X-Tenant-Id/X-User-Id；公网或不可信网络应使用 jwt_hs256。
MEMORY_AUTH_MODE=jwt_hs256
MEMORY_TENANT_IDS=demo-tenant,tenant-a
# 仅限受控内网测试；true 时 trusted_user_id 接受任意格式合法的租户 ID，生产必须为 false。
MEMORY_ALLOW_DYNAMIC_TENANT=false
MEMORY_JWT_ISSUER=lazytt-demo-web-api
MEMORY_JWT_AUDIENCE=lazytt-memory-service
DEMO_TENANT_ID=demo-tenant
DEMO_USER_ID=semantic-demo
DEMO_PROJECT_ID=lazytt-memory-system-demo

# 旧版完整本地栈兼容密钥；server-runtime 连接远程 PG/ES 时大部分不使用。
MEMORY_POSTGRES_PASSWORD=
MEM0_POSTGRES_PASSWORD=
MEM0_API_KEY=
MEM0_JWT_SECRET=
MEMORY_JWT_HS256_SECRET=

# PostgreSQL 18.4 与 Elasticsearch 8.11.3：可填写本机或局域网服务器地址。
# PostgreSQL 密码会进入 DATABASE_URL，因此应使用 URL-safe 字符。
POSTGRES_USER=lazytt_memory_app
POSTGRES_PASSWORD=
POSTGRES_DB=lazytt_memory
POSTGRES_PORT=55433
MEMORY_POSTGRES_HOST=replace-with-postgresql-host
MEMORY_APP_POSTGRES_USER=lazytt_memory_app
MEMORY_APP_POSTGRES_PASSWORD=
MEMORY_APP_POSTGRES_DB=lazytt_memory
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_HOST=replace-with-elasticsearch-host
ES_JAVA_OPTS=-Xms1g -Xmx1g
MEMORY_HOST_PORT=8080
LOCAL_ELASTICSEARCH_INDEX_PREFIX=lazytt-memory-migration

# PostgreSQL 是权威记忆总账。local 使用 Compose 内置库；external 连接准备好的远程库。
# MEMORY_DATABASE_URL 如果含密码，只能放在本地 .env 或密钥管理系统中。
MEMORY_POSTGRES_MODE=local
MEMORY_DATABASE_URL=

# 检索投影 Provider：Elasticsearch/Mem0 只负责搜索，PostgreSQL 始终是权威来源。
MEMORY_INDEX_PROVIDER=mem0
MEMORY_INDEX_TIMEOUT_SECONDS=10
ELASTICSEARCH_BASE_URL=https://replace-with-your-elasticsearch-host:9200
ELASTICSEARCH_API_KEY=
# Elasticsearch 临时 Basic Auth；同时配置 API Key 时优先使用 API Key。
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=lazytt-memory
ELASTICSEARCH_REQUIRED_VERSION=8.11.3
MEMORY_ALLOW_INSECURE_INDEX_HTTP=false

# 百炼 Embedding：生成语义向量。aliyun-bailian 默认复用 OPENAI_API_KEY，
# MEMORY_EMBEDDING_API_KEY 仅作为可选覆盖。模型或维度改变后必须新建 Generation。
MEMORY_EMBEDDING_PROVIDER=aliyun-bailian
MEMORY_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=text-embedding-v4
MEMORY_EMBEDDING_REVISION=bailian-text-embedding-v4-2026-08-24
MEMORY_EMBEDDING_DIMENSIONS=1024
MEMORY_EMBEDDING_NORMALIZATION=l2
MEMORY_EMBEDDING_INSTRUCTION_VERSION=bailian-symmetric-v1
MEMORY_EMBEDDING_REQUEST_DIALECT=openai
MEMORY_EMBEDDING_SEMANTIC=true
MEMORY_EMBEDDING_TIMEOUT_SECONDS=30

# 百炼 Reranker：对 Elasticsearch 召回候选进行二次相关性排序。
MEMORY_RERANK_MODE=dedicated
MEMORY_DEDICATED_RERANK_BASE_URL=https://dashscope.aliyuncs.com
MEMORY_DEDICATED_RERANK_API_KEY=
MEMORY_DEDICATED_RERANK_MODEL=qwen3-rerank
MEMORY_DEDICATED_RERANK_REVISION=bailian-qwen3-rerank-2026-08-24
MEMORY_DEDICATED_RERANK_DIALECT=bailian_qwen3
MEMORY_DEDICATED_RERANK_MINIMUM_SCORE=0.10
MEMORY_DEDICATED_RERANK_TIMEOUT_SECONDS=30

# 本地模型兼容配置；切换模型或维度时也必须创建新的投影 Generation。
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
LOCAL_EMBEDDING_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
LOCAL_EMBEDDING_DIMENSIONS=1024
LOCAL_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
LOCAL_RERANK_REVISION=e61197e
MEM0_COLLECTION_NAME=memories_qwen3_1024

# Hugging Face 下载兼容配置，仅在使用本地模型容器时生效。
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=60
HF_HUB_ETAG_TIMEOUT=30
