# Copy this file to .env, replace placeholders, then run:
#   ./scripts/bootstrap-backend-env.sh
# The bootstrap script generates the local database, Mem0 and JWT secrets.

# OpenAI-compatible automatic extraction. DeepSeek is one supported provider.
# Set the mode to disabled when the Agent supplies explicit memory events and
# no automatic extraction is needed. Never commit a real API key.
MEMORY_EXTRACT_MODE=openai_compatible
OPENAI_API_KEY=replace-with-your-provider-api-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=replace-with-your-provider-model

# Optional legacy Kimi mode. Select MEMORY_EXTRACT_MODE=kimi to use it.
KIMI_API_KEY=replace-with-your-kimi-api-key
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=k3
# Use trusted_user_id only on an isolated internal network. The caller supplies
# X-Tenant-Id and X-User-Id and no bearer token is required. Keep jwt_hs256 for
# public/untrusted networks. Both modes allow only configured tenant IDs.
MEMORY_AUTH_MODE=jwt_hs256
MEMORY_TENANT_IDS=demo-tenant,tenant-a
MEMORY_JWT_ISSUER=lazytt-demo-web-api
MEMORY_JWT_AUDIENCE=lazytt-memory-service
DEMO_TENANT_ID=demo-tenant
DEMO_USER_ID=semantic-demo
DEMO_PROJECT_ID=lazytt-memory-system-demo

# Generated locally by scripts/bootstrap-backend-env.sh. Never commit real values.
MEMORY_POSTGRES_PASSWORD=
MEM0_POSTGRES_PASSWORD=
MEM0_API_KEY=
MEM0_JWT_SECRET=
MEMORY_JWT_HS256_SECRET=

# Local PostgreSQL 18.4 + Elasticsearch 8.11.3 Compose profile.
# POSTGRES_PASSWORD must be URL-safe because it is embedded in DATABASE_URL.
POSTGRES_USER=lazytt_memory_app
POSTGRES_PASSWORD=
POSTGRES_DB=lazytt_memory
POSTGRES_PORT=55433
MEMORY_POSTGRES_HOST=replace-with-postgresql-host
MEMORY_APP_POSTGRES_USER=lazytt_memory_app
MEMORY_APP_POSTGRES_PASSWORD=
MEMORY_APP_POSTGRES_DB=lazytt_memory
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_HOST=replace-with-elasticsearch-host
ES_JAVA_OPTS=-Xms1g -Xmx1g
MEMORY_HOST_PORT=8080
LOCAL_ELASTICSEARCH_INDEX_PREFIX=lazytt-memory-migration

# Authoritative PostgreSQL. Keep local for the bundled PostgreSQL container.
# Use external only after MEMORY_DATABASE_URL points to a prepared remote
# PostgreSQL database. Never commit a URL containing a real password.
MEMORY_POSTGRES_MODE=local
MEMORY_DATABASE_URL=

# Retrieval projection provider. PostgreSQL remains authoritative in both modes.
MEMORY_INDEX_PROVIDER=mem0
MEMORY_INDEX_TIMEOUT_SECONDS=10
ELASTICSEARCH_BASE_URL=https://replace-with-your-elasticsearch-host:9200
ELASTICSEARCH_API_KEY=
# Temporary Basic Auth alternative. API Key takes precedence when both are set.
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=lazytt-memory
ELASTICSEARCH_REQUIRED_VERSION=8.11.3
MEMORY_ALLOW_INSECURE_INDEX_HTTP=false

# Optional cloud profile. The same SiliconFlow key may be used for both calls.
MEMORY_EMBEDDING_PROVIDER=siliconflow
MEMORY_EMBEDDING_BASE_URL=https://api.siliconflow.cn
MEMORY_EMBEDDING_API_KEY=replace-with-your-siliconflow-key
MEMORY_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
MEMORY_EMBEDDING_REVISION=siliconflow-cloud-2026-07-31
MEMORY_EMBEDDING_DIMENSIONS=1024
MEMORY_EMBEDDING_NORMALIZATION=l2
MEMORY_EMBEDDING_INSTRUCTION_VERSION=mem0-symmetric-document-v1
MEMORY_EMBEDDING_SEMANTIC=true
MEMORY_EMBEDDING_TIMEOUT_SECONDS=30

MEMORY_RERANK_MODE=dedicated
MEMORY_DEDICATED_RERANK_BASE_URL=https://api.siliconflow.cn
MEMORY_DEDICATED_RERANK_API_KEY=replace-with-your-siliconflow-key
MEMORY_DEDICATED_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
MEMORY_DEDICATED_RERANK_REVISION=siliconflow-cloud-2026-07-31
MEMORY_DEDICATED_RERANK_MINIMUM_SCORE=0.10
MEMORY_DEDICATED_RERANK_TIMEOUT_SECONDS=30

# Local model profile defaults. Change together with a new projection generation.
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
LOCAL_EMBEDDING_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
LOCAL_EMBEDDING_DIMENSIONS=1024
LOCAL_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
LOCAL_RERANK_REVISION=e61197e
MEM0_COLLECTION_NAME=memories_qwen3_1024

# Hugging Face download compatibility. Set HF_HUB_DISABLE_XET=0 when Xet works
# better on the current network; partial downloads resume from the model cache volume.
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=60
HF_HUB_ETAG_TIMEOUT=30
