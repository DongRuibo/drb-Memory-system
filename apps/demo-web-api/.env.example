DEMO_WEB_API_BIND=127.0.0.1:8090
DEMO_WEB_API_CONTAINER_MODE=false
DEMO_DATABASE_URL=postgres://memory:memory-local-only@127.0.0.1:55432/memory_demo
DEMO_WEB_ALLOWED_ORIGINS=http://localhost:3000
DEMO_WEB_SECURE_COOKIE=false

MEMORY_BASE_URL=http://127.0.0.1:8080
# Only for a local container connecting to http://host.docker.internal:8080.
MEMORY_ALLOW_DOCKER_HOST_HTTP=false
MEMORY_JWT_HS256_SECRET=replace-with-at-least-32-random-bytes
MEMORY_JWT_ISSUER=lazytt-demo-web-api
MEMORY_JWT_AUDIENCE=lazytt-memory-service
DEMO_TENANT_ID=demo-tenant

KIMI_API_KEY=replace-with-your-kimi-api-key
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=k3

# Optional DeepSeek chat alternative (set all three together):
# DEMO_CHAT_API_KEY=<REDACTED>
# DEMO_CHAT_BASE_URL=https://api.deepseek.com
# DEMO_CHAT_MODEL=deepseek-flash
